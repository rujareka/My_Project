l_01.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_01_3.PNG"}}, {"model": "api.idol", "pk": 2, "fields": {"idol_id": "2", "name": "시노다 사키", "leader_gimmick": "하이 텐션\r\n당신이 성원 칩을 얻게 된다면, 그 대신 당신의 볼티지를 +10% 해도 된다.", "description": "", "start_vol": 40, "start_hand": 5, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_02.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_02_3.PNG"}}, {"model": "api.idol", "pk": 3, "fields": {"idol_id": "3", "name": "히메노 에리", "leader_gimmick": "하트에 록 온\r\n당신은 성원 칩 1개와 다음 성원 효과를 갖는다. (성원 소비 1) 관객석에 있는 카드 1장을 선택하고, 그 카드 위에 독점 칩을 놓아 독점 상태로 만든다", "description": "", "start_vol": 30, "start_hand": 5, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_03.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_03_3.PNG"}}, {"model": "api.idol", "pk": 4, "fields": {"idol_id": "4", "name": "루리카와 오토하", "leader_gimmick": "칸타빌레\r\n당신의 메인 페이즈를 시작할 때, 당신은 관객 덱 가장 위에 있는 카드를 보고, 그 카드를 관객 덱의 가장 위나 아래에 놓을 수 있다.", "description": "", "start_vol": 30, "start_hand": 6, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_04.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_04_3.PNG"}}, {"model": "api.idol", "pk": 5, "fields": {"idol_id": "5", "name": "히이라기 료코", "leader_gimmick": "어레인지먼트\r\n당신의 메인 페이즈를 시작할 때, 당신의 메모리가 10장 이상이라면, 관객석에서 카드 1장을 골라 획득 할 수 있다.", "description": "", "start_vol": 30, "start_hand": 5, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_05.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_05_3.PNG"}}, {"model": "api.idol", "pk": 6, "fields": {"idol_id": "6", "name": "코즈키 후미노", "leader_gimmick": "마법에 걸려\r\n당신이 성원 효과를 사용했다면. 이번턴, 당신이 다음번에 사용하는 노래 카드의 팬 획득 장수를 +1 한다.(이 효과는 중첩되지 않는다.)", "description": "", "start_vol": 30, "start_hand": 4, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_06.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_06_3.PNG"}}, {"model": "api.idol", "pk": 7, "fields": {"idol_id": "7", "name": "시노미아 쥬리", "leader_gimmick": "리프레인\r\n당신의 메인 페이즈 도중 1번만 수행할 수 있다. 손에서 카드 1장을 버린 카드 더미에 놓는다. 그렇게 한 경우, 버린 카드 더미에서 1장을 골라, 비용을 지불하고 사용할 수 있다. 사용한 카드는 메모리에 놓는 대신, 노래 덱의 가장 아래에 놓는다.", "description": "", "start_vol": 40, "start_hand": 5, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_07.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_07_3.PNG"}}, {"model": "api.idol", "pk": 8, "fields": {"idol_id": "8", "name": "타카나시 츠카사", "leader_gimmick": "리차지\r\n당신이 이벤트 카드를 사용했을 때, 당신의 아이돌 1명을 백스테이지로 되돌릴 수 있다. (이 효과를 이벤트 카드보다 우선하여 해결한다) 이 효과는 1턴에 1번만 사용할 수 있다.", "description": "", "start_vol": 30, "start_hand": 4, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Characters/Idol_08.jpg", "icon_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Ranking/Idol_Profile_08_3.PNG"}}, {"model": "api.idol", "pk": 9, "fields": {"idol_id": "9", "name": "아마우 카논", "leader_gimmick": "카논 빔~!\r\n당신의 메인 페이즈를 시작할 때, 당신은 성원 칩을 1개 획득한다.", "description": "", "start_vol": 20, "start_hand": 4, "pick_count": 0, "win_count": 0, "banner_img_url": "https://cdn.jsdelivr.net/gh/rujareka/My_Project@main/static/imgs/Idol/Ch